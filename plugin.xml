<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <!-- 🦙 EclipseLlama Perspective -->
  <extension point="org.eclipse.ui.perspectives">
    <perspective
      name="EclipseLlama"
      icon="icons/chat.png"
      class="com.eclipsellama.plugin.ui.EclipseLlamaPerspective"
      id="com.eclipsellama.plugin.perspective"/>
  </extension>

  <!-- 🦙 Main Chat View -->
  <extension point="org.eclipse.ui.views">
    <view
      name="EclipseLlama Chat"
      icon="icons/chat.png"
      class="com.eclipsellama.plugin.ui.chat.ChatView"
      id="com.eclipsellama.plugin.view.chat"/>
  </extension>

  <!-- 🦙 Place Chat View on Left in Perspective -->
  <extension point="org.eclipse.ui.perspectiveExtensions">
    <view
      id="com.eclipsellama.plugin.view.chat"
      relative="org.eclipse.ui.editors"
      relationship="left"
      visible="true"
      ratio="0.25"/>
  </extension>

  <!-- 🦙 First-Time Setup -->
  <extension point="org.eclipse.ui.startup">
    <startup class="com.eclipsellama.plugin.setup.SetupLauncher"/>
  </extension>

  <!-- 🦙 Preferences Page -->
    <extension point="org.eclipse.ui.preferencePages">
      <!-- Category for EclipseLlama preferences -->
      <category
        id="com.eclipsellama.plugin.preference.category"
        name="EclipseLlama"/>
      <page
        id="com.eclipsellama.plugin.preferences"
        name="EclipseLlama"
        icon="icons/setting.png"
        class="com.eclipsellama.plugin.preferences.EclipseLlamaPreferencePage"
        categoryId="com.eclipsellama.plugin.preference.category"/>
      <!-- NEW MCP PREFERENCE PAGE -->
      <page
        id="com.eclipsellama.plugin.preferences.mcp"
        name="MCP Servers"
        class="com.eclipsellama.plugin.preferences.McpPreferencePage"
        icon="icons/setting.png"
        categoryId="com.eclipsellama.plugin.preference.category"/>
    </extension>

  <!-- 🦙 Commands -->
  <extension point="org.eclipse.ui.commands">
    <category id="com.eclipsellama.plugin.category" name="EclipseLlama"/>

    <!-- Existing commands (unchanged) -->
    <command
      id="com.eclipsellama.plugin.command.openChat"
      name="Open EclipseLlama Chat"
      description="Open the EclipseLlama chat view"
      categoryId="com.eclipsellama.plugin.category"/>
    <command
      id="com.eclipsellama.plugin.command.explainCode"
      name="Explain Code"
      description="Explain selected code with AI"
      categoryId="com.eclipsellama.plugin.category"/>
    <command
      id="com.eclipsellama.plugin.command.fixCode"
      name="Fix Code"
      description="Suggest fixes for selected code"
      categoryId="com.eclipsellama.plugin.category"/>
    <command
      id="com.eclipsellama.plugin.command.generateTests"
      name="Generate Tests"
      description="Generate unit tests for selected code"
      categoryId="com.eclipsellama.plugin.category"/>
    <command
      id="com.eclipsellama.plugin.command.documentCode"
      name="Add Documentation"
      description="Generate Javadoc for selected code"
      categoryId="com.eclipsellama.plugin.category"/>
    <command
      id="com.eclipsellama.plugin.command.generateCommit"
      name="Generate Commit Message"
      description="Generate AI commit message from git diff"
      categoryId="com.eclipsellama.plugin.category"/>
    <command
      id="com.eclipsellama.plugin.command.refactorCode"
      name="Refactor Code"
      description="Refactor selected code with AI"
      categoryId="com.eclipsellama.plugin.category"/>
    <command
      id="com.eclipsellama.plugin.command.reviewCode"
      name="Review Code"
      description="Review selected code with AI"
      categoryId="com.eclipsellama.plugin.category"/>
    <command
      id="com.eclipsellama.plugin.command.convertCode"
      name="Convert Code"
      description="Convert selected code with AI"
      categoryId="com.eclipsellama.plugin.category"/>

    <!-- NEW COMMAND: Open MCP -->
    <command
      id="com.eclipsellama.plugin.command.openMcp"
      name="Open MCP Server"
      description="Open an MCP server configuration"
      categoryId="com.eclipsellama.plugin.category"/>
  </extension>

  <!-- 🦙 Command Handlers -->
  <extension point="org.eclipse.ui.handlers">
    <handler
      commandId="com.eclipsellama.plugin.command.openChat"
      class="com.eclipsellama.plugin.handlers.OpenChatHandler"/>
    <handler
      commandId="com.eclipsellama.plugin.command.explainCode"
      class="com.eclipsellama.plugin.handlers.ExplainCodeHandler"/>
    <handler
      commandId="com.eclipsellama.plugin.command.fixCode"
      class="com.eclipsellama.plugin.handlers.FixCodeHandler"/>
    <handler
      commandId="com.eclipsellama.plugin.command.generateTests"
      class="com.eclipsellama.plugin.handlers.GenerateTestsHandler"/>
    <handler
      commandId="com.eclipsellama.plugin.command.documentCode"
      class="com.eclipsellama.plugin.handlers.DocumentCodeHandler"/>
    <handler
      commandId="com.eclipsellama.plugin.command.generateCommit"
      class="com.eclipsellama.plugin.handlers.GenerateCommitHandler"/>
    <handler
      commandId="com.eclipsellama.plugin.command.refactorCode"
      class="com.eclipsellama.plugin.handlers.RefactorCodeHandler"/>
    <handler
      commandId="com.eclipsellama.plugin.command.reviewCode"
      class="com.eclipsellama.plugin.handlers.ReviewCodeHandler"/>
    <handler
      commandId="com.eclipsellama.plugin.command.convertCode"
      class="com.eclipsellama.plugin.handlers.ConvertCodeHandler"/>

    <!-- NEW HANDLER: Open MCP -->
    <handler
      commandId="com.eclipsellama.plugin.command.openMcp"
      class="com.eclipsellama.plugin.handlers.OpenMcpHandler"/>
  </extension>

  <!-- 🦙 Context Menu for Java Editor -->
  <extension point="org.eclipse.ui.menus">
    <!-- Help Menu Entry -->
    <menuContribution locationURI="menu:help?after=additions">
      <command
        commandId="com.eclipsellama.plugin.command.openChat"
        label="EclipseLlama Chat"
        icon="icons/chat.png"/>
    </menuContribution>

    <!-- Universal Popup Menu - Works Everywhere -->
    <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
      <menu
        id="com.eclipsellama.plugin.menu"
        label="EclipseLlama"
        icon="icons/chat.png">
        <command
          commandId="com.eclipsellama.plugin.command.explainCode"
          label="Explain This Code"
          style="push"/>
        <command
          commandId="com.eclipsellama.plugin.command.fixCode"
          label="Fix This Code"
          style="push"/>
        <command
          commandId="com.eclipsellama.plugin.command.generateTests"
          label="Generate Tests"
          style="push"/>
        <command
          commandId="com.eclipsellama.plugin.command.documentCode"
          label="Add Documentation"
          style="push"/>
        <command
          commandId="com.eclipsellama.plugin.command.refactorCode"
          label="Refactor This Code"
          style="push"/>
        <command
          commandId="com.eclipsellama.plugin.command.reviewCode"
          label="Review This Code"
          style="push"/>
        <command
          commandId="com.eclipsellama.plugin.command.convertCode"
          label="Convert This Code"
          style="push"/>
        <separator name="separator1"/>
        <command
          commandId="com.eclipsellama.plugin.command.generateCommit"
          label="Generate Commit Message"
          style="push"/>
        <separator name="separator2"/>
        <command
          commandId="com.eclipsellama.plugin.command.openChat"
          label="Open Chat"
          style="push"/>
      </menu>
    </menuContribution>
  </extension>

  <!-- 🦙 Keyboard Shortcuts -->
  <extension point="org.eclipse.ui.bindings">
    <key
      commandId="com.eclipsellama.plugin.command.openChat"
      contextId="org.eclipse.ui.contexts.window"
      schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
      sequence="Ctrl+Shift+L"/>
    <key
      commandId="com.eclipsellama.plugin.command.explainCode"
      contextId="org.eclipse.jdt.ui.javaEditorScope"
      schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
      sequence="Ctrl+Shift+E"/>
  </extension>

  <!-- 🦙 Java Autocomplete -->
  <extension point="org.eclipse.jdt.ui.javaCompletionProposalComputer"
             id="com.eclipsellama.plugin.completion.extension">
    <proposalComputer
      id="com.eclipsellama.plugin.completion"
      name="EclipseLlama Completion"
      class="com.eclipsellama.plugin.completion.EclipseLlamaProposalComputer"
      activate="true">
      <partition type="__dftl_partition_content_type"/>
    </proposalComputer>
  </extension>
</plugin>